*.iml
.gradle

# Ignora a pasta inteira de configurações do Android Studio/IntelliJ,
# ela é local de cada máquina e não precisa ser compartilhada.
/.idea/

.DS_Store
/build
/captures
.externalNativeBuild
.cxx
local.properties

# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Exceção: o jar do Gradle Wrapper é necessário para o ./gradlew funcionar
# sem precisar ter o Gradle instalado na máquina, por isso precisa ser versionado.
!gradle/wrapper/gradle-wrapper.jar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Kotlin Gradle plugin data, see https://kotlinlang.org/docs/whatsnew20.html#new-directory-for-kotlin-data-in-gradle-projects
.kotlin/

# Segredos e assinatura de app: nunca devem ir para o repositório público.
*.jks
*.keystore
key.properties
*.p12
*.pem
.env
.env.*
google-services.json
GoogleService-Info.plist

# Notas e planejamentos locais, não fazem parte do código versionado.
/notas/
